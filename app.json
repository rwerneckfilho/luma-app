{
  "expo": {
    "name": "LUMA",
    "slug": "luma-app",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/luma-icon.png",
    "scheme": "luma",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/luma-icon.png",
      "bundleIdentifier": "life.myluma.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": true
    },
    "android": {
      "package": "life.myluma.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FAFAF7",
        "foregroundImage": "./assets/images/luma-symbol.png",
        "monochromeImage": "./assets/images/luma-monochrome-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF7",
          "image": "./assets/images/luma-symbol.png",
          "imageWidth": 132
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/luma-notification-icon.png",
          "color": "#007680",
          "defaultChannel": "medication_reminders"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Permita que a LUMA use o Face ID para proteger seus dados."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false,
          "photosPermission": "Permita que a LUMA selecione uma foto para o seu perfil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b91fa9e2-1dfe-4457-a266-470cb35abbe6"
      }
    }
  }
}
